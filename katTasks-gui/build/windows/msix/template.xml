<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="katTasks-gui"
        Arguments=""
        InstallLocation="C:\Program Files\devinthemtn\katTasks">
    </Installer>
    <PackageInformation
        PackageName="katTasks"
        PackageDisplayName="katTasks"
        PublisherName="CN=devinthemtn"
        PublisherDisplayName="devinthemtn"
        Version="0.3.0.0"
        PackageDescription="Keyboard-driven todo.txt task manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.devinthemtn.kattasks"
                Description="Keyboard-driven todo.txt task manager"
                DisplayName="katTasks"
                ExecutableName="katTasks-gui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>katTasks</DisplayName>
            <PublisherDisplayName>devinthemtn</PublisherDisplayName>
            <Description>Keyboard-driven todo.txt task manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="katTasks-gui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
